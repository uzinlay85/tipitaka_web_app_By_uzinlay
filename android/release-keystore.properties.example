# ==============================================================================
# Tipitaka Android Release Keystore Configuration
# Copy this file to `release-keystore.properties` (which is git-ignored)
# and fill in your private passwords. DO NOT commit release-keystore.properties!
# ==============================================================================

RELEASE_STORE_FILE=tipitaka-release.jks
RELEASE_KEY_ALIAS=tipitaka
RELEASE_STORE_PASSWORD=your_store_password_here
RELEASE_KEY_PASSWORD=your_key_password_here
