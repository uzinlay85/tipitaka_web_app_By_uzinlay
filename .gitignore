# ============================================
# Git Ignore for Tipitaka Web Reader
# ============================================

# Database files (Over GitHub 100MB limit - already in place on VPS)
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
tipitaka_pali.db
tipitaka_mm.db

# Archives and Large Binaries
*.zip
*.tar.gz
*.apk
base.apk
tipitaka_vps.zip
code_update.zip
Tipitaka_Deploy_Package/

# Python virtual env & cache
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.env

# Raw data extraction directory
Tipitak_MM/
scratch/


# local-only runtime/font assets
server.log
static/Zawgyi-One.ttf
static/*zawgyi*.css

# Android build outputs
android/.gradle/
android/build/
android/app/build/
local.properties
